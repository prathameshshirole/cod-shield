msgid "COD Shield for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: cod-shield.php
msgid "https://wordpress.org/plugins/cod-shield/"
msgstr ""

#. Description of the plugin
#: cod-shield.php
msgid "Reduce COD RTO by collecting a partial advance payment through existing WooCommerce gateways (Razorpay, Cashfree, etc.). Includes a global COD kill switch, configurable advance rules, an extra COD fee, checkout messaging, and full admin order visibility."
msgstr ""

